    {
      "name": "Functions - Create",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Проверка наличия необходимых переменных",
              "if (!pm.environment.get('userId')) {",
              "    throw new Error('userId is not set. Please run Users - Create first.');",
              "}",
              "// Установка значений для функции",
              "pm.environment.set('functionName', `func_${Date.now()}`);",
              "pm.environment.set('functionExpression', 'x*x');",
              "// Explicitly set the request body to ensure correct format",
              "const requestBody = {",
              "    name: pm.environment.get('functionName'),",
              "    mathFunctionType: 'SqrFunction',",
              "    xFrom: 0.0,",
              "    xTo: 10.0,",
              "    count: 11",
              "};",
              "pm.request.body.raw = JSON.stringify(requestBody);",
              "console.log('Request body set to:', pm.request.body.raw);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code !== 201) {",
              "    console.log('Response status:', pm.response.code);",
              "    console.log('Response body:', pm.response.text());",
              "    console.log('Request body:', pm.request.body.raw);",
              "    console.log('functionName variable:', pm.environment.get('functionName'));",
              "}",
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Response has function data', function () {",
              "    var responseData = pm.response.json();",
              "    pm.environment.set('functionId', responseData.id);",
              "    // Function is created with the authenticated user's ID, not the userId from environment",
              "    pm.expect(responseData).to.have.property('userId');",
              "    pm.expect(responseData.userId).to.be.a('number');",
              "    pm.expect(responseData.userId).to.be.above(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{functionName}}\",\n  \"mathFunctionType\": \"SqrFunction\",\n  \"xFrom\": 0.0,\n  \"xTo\": 10.0,\n  \"count\": 11\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/functions/create-from-math",
          "host": ["{{baseUrl}}"],
          "path": ["api", "functions", "create-from-math"]
        }
      }
    },
