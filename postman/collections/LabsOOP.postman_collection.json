{
  "info": {
    "name": "LabsOOP API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{authUsername}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{authPassword}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Users - Create",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set('username', `user_${Date.now()}`);",
              "pm.environment.set('passwordHash', `pass_${Date.now()}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Response has user data', function () {",
              "    var responseData = pm.response.json();",
              "    pm.environment.set('userId', responseData.id);",
              "    pm.environment.set('username', responseData.username);",
              "    pm.expect(responseData).to.have.property('id');",
              "    pm.expect(responseData).to.have.property('username');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"passwordHash\": \"{{passwordHash}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users"]
        }
      }
    },
    {
      "name": "Users - Get All",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
